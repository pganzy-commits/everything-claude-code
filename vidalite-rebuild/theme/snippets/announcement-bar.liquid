{%- comment -%}
  VidaLite — Announcement Bar
  Subtle, dark bar for key messaging (free shipping, trade program, etc.)
{%- endcomment -%}

{%- assign show_announcement = true -%}

{%- if show_announcement -%}
<div class="announcement-bar" data-announcement-bar>
  <div class="announcement-bar__inner container--wide">
    <p class="announcement-bar__message">
      Free Shipping on All Orders &nbsp;&bull;&nbsp; <a href="/pages/trade">Trade Professionals: Apply for Trade Pricing</a>
    </p>
    <button class="announcement-bar__close" aria-label="Dismiss announcement" data-announcement-close>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="2" y1="2" x2="12" y2="12"/>
        <line x1="12" y1="2" x2="2" y2="12"/>
      </svg>
    </button>
  </div>
</div>
{%- endif -%}

<style>
  .announcement-bar {
    background-color: var(--color-black);
    color: var(--color-off-white);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }

  .announcement-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--gutter);
    position: relative;
  }

  .announcement-bar__message {
    text-align: center;
    line-height: var(--leading-normal);
  }

  .announcement-bar__message a {
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: opacity var(--duration-fast) ease;
  }

  .announcement-bar__message a:hover {
    opacity: 0.7;
  }

  .announcement-bar__close {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: var(--color-off-white);
    opacity: 0.6;
    transition: opacity var(--duration-fast) ease;
  }

  .announcement-bar__close:hover {
    opacity: 1;
  }
</style>
