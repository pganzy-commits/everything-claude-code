{%- comment -%}
  VidaLite — Hero Banner
  Full-bleed lifestyle photography with bold overlaid headline.
  Helium Lyte reference: Pages 1-3 (dramatic hero with type overlay)
{%- endcomment -%}

<section class="hero-banner" data-section-id="{{ section.id }}">
  <div class="hero-banner__media">
    {%- if section.settings.image -%}
      <img
        src="{{ section.settings.image | image_url: width: 2400 }}"
        srcset="
          {{ section.settings.image | image_url: width: 800 }} 800w,
          {{ section.settings.image | image_url: width: 1200 }} 1200w,
          {{ section.settings.image | image_url: width: 1800 }} 1800w,
          {{ section.settings.image | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: 'VidaLite lighting in a beautifully designed space' }}"
        loading="eager"
        fetchpriority="high"
        class="hero-banner__img"
      >
    {%- else -%}
      {%- comment -%} [FOUNDER TO PROVIDE] Hero lifestyle image: fixtures in an architectural interior {%- endcomment -%}
      <div class="hero-banner__placeholder">
        <span class="hero-banner__placeholder-text">[FOUNDER TO PROVIDE: Hero lifestyle photograph — VidaLite fixtures in an architectural interior]</span>
      </div>
    {%- endif -%}
    <div class="hero-banner__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  </div>

  <div class="hero-banner__content container">
    <div class="hero-banner__content-inner" data-animate>
      {%- if section.settings.heading != blank -%}
        <h1 class="hero-banner__heading text-display">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero-banner__subheading">
          {{ section.settings.subheading }}
        </p>
      {%- endif -%}

      <div class="hero-banner__actions">
        {%- if section.settings.button_text != blank -%}
          <a href="{{ section.settings.button_url }}" class="btn btn--inverse btn--lg">
            {{ section.settings.button_text }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_secondary_text != blank -%}
          <a href="{{ section.settings.button_secondary_url }}" class="btn btn--ghost" style="color: var(--color-off-white); border-bottom-color: var(--color-off-white);">
            {{ section.settings.button_secondary_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} Scroll indicator {%- endcomment -%}
  <div class="hero-banner__scroll">
    <span>Scroll</span>
    <div class="hero-banner__scroll-line"></div>
  </div>
</section>

<style>
  .hero-banner {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-banner__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .hero-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-banner__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 50%, #0d0d0d 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-banner__placeholder-text {
    color: rgba(255, 255, 255, 0.3);
    font-size: var(--text-sm);
    text-align: center;
    padding: var(--space-8);
  }

  .hero-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.7) 0%,
      rgba(0, 0, 0, 0.2) 50%,
      rgba(0, 0, 0, 0.1) 100%
    );
  }

  .hero-banner__content {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(4rem, 8vw, 8rem);
  }

  .hero-banner__content-inner {
    max-width: 800px;
  }

  .hero-banner__heading {
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }

  .hero-banner__subheading {
    font-size: var(--text-lg);
    color: rgba(231, 225, 209, 0.85);
    max-width: 550px;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
  }

  .hero-banner__actions {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .hero-banner__scroll {
    position: absolute;
    bottom: var(--space-8);
    right: var(--gutter);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: rgba(231, 225, 209, 0.5);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
  }

  .hero-banner__scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, rgba(231, 225, 209, 0.5), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.5; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(1.2); }
  }

  @media (max-width: 768px) {
    .hero-banner {
      min-height: 85vh;
      min-height: 85svh;
    }

    .hero-banner__scroll {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Recommended: 2400x1350px. Use lifestyle photography of fixtures in architectural spaces."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Light That Defines Space"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Architectural lighting designed for the world's most considered interiors"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Primary button text",
      "default": "Explore Collections"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_secondary_text",
      "label": "Secondary button text",
      "default": "Trade Program"
    },
    {
      "type": "url",
      "id": "button_secondary_url",
      "label": "Secondary button link"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40,
      "unit": "%"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
